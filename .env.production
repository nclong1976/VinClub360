# ============================================
# PRODUCTION ENVIRONMENT VARIABLES
# ============================================
# DO NOT commit actual secrets to this file.
# Set these values in Render Dashboard > Environment

# --- VITE (Frontend) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_TELEGRAM_BOT_USERNAME=

# --- NODE (Backend) ---
NODE_ENV=production
PORT=3000
NODE_VERSION=20

# --- Supabase (Server-side) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google GenAI ---
GEMINI_API_KEY=

# --- Telegram Integration (Optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BUSINESS_USERNAME=
TELEGRAM_WEBHOOK_URL=

# --- Render (Auto-set by platform) ---
# RENDER_EXTERNAL_URL is automatically provided
