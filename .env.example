# ============================================
# ENVIRONMENT VARIABLES - VinClub360
# ============================================
# Copy this file to .env.local and fill in your values
# Never commit actual secrets to version control

# --- FRONTEND (Vite) ---
# Get these from Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key

# Optional: Telegram username for direct contact
VITE_TELEGRAM_BOT_USERNAME=your_bot_username

# --- BACKEND (Node.js) ---
NODE_ENV=development
PORT=3000

# Supabase Service Role (Server-side only, never expose to frontend)
# Get this from Supabase Dashboard > Project Settings > API > Service Role Secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Google GenAI (Gemini) ---
# Get from https://aistudio.google.com/app/apikeys
GEMINI_API_KEY=your-gemini-api-key

# --- Telegram Integration (Optional) ---
# Create bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Get Chat ID by adding bot to a group and calling /getUpdates
TELEGRAM_CHAT_ID=your-group-chat-id

# Business account username (for Business Messages feature)
TELEGRAM_BUSINESS_USERNAME=@your_business_account

# Your public server URL (set by Render, or custom domain)
TELEGRAM_WEBHOOK_URL=https://your-domain.com

# ============================================
# DEPLOYMENT NOTES
# ============================================
# For Render deployment:
# 1. Create .env.local for development
# 2. Set environment variables in Render Dashboard:
#    - Do NOT check "Sync with .env.production"
#    - Manually enter each secret value
# 3. Never expose SUPABASE_SERVICE_ROLE_KEY or GEMINI_API_KEY to frontend
